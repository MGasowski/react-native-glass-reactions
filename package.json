{
  "name": "react-native-glass-reactions",
  "version": "0.1.0",
  "description": "Native Instagram-style reactions picker with iOS 26 Liquid Glass",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-glass-reactions-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "app.plugin.js",
    "plugin/build",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-glass-reactions-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib plugin/build",
    "prepare": "bob build && yarn build:plugin",
    "nitrogen": "nitrogen",
    "typecheck": "tsc && tsc --noEmit -p plugin",
    "lint": "eslint \"**/*.{js,ts,tsx}\" && yarn check:glass-guards && yarn check:plugin",
    "build:plugin": "tsc --build plugin",
    "check:glass-guards": "node scripts/check-glass-guards.mjs",
    "ab:control": "sed -i '' 's/TRIGGERS_ENABLED = true/TRIGGERS_ENABLED = false/' example/src/ab-config.ts",
    "ab:restore": "sed -i '' 's/TRIGGERS_ENABLED = false/TRIGGERS_ENABLED = true/' example/src/ab-config.ts",
    "check:plugin": "yarn build:plugin && node scripts/check-plugin.mjs && node scripts/check-plugin-prebuild.mjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MGasowski/react-native-glass-reactions.git"
  },
  "author": "MGasowski <gasowski0marcin@gmail.com> (https://github.com/MGasowski)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MGasowski/react-native-glass-reactions/issues"
  },
  "homepage": "https://github.com/MGasowski/react-native-glass-reactions#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@expo/config-plugins": "^57.0.8",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "nitrogen": "^0.36.5",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.36.5",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-nitro-modules": ">=0.36.5 <0.37.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-view",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
