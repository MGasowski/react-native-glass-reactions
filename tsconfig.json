{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-glass-reactions": ["./src/index"]
    },
    // The `node --test` suites import source directly, and Node's ESM
    // resolution requires a real extension. Safe here because `noEmit` is on —
    // bob does the building, so no `.ts` specifier ever reaches output.
    "allowImportingTsExtensions": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "react-native-glass-reactions-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Node's own globals, for the `node --test` suites. Listed explicitly
    // because automatic @types discovery does not reach them under this
    // resolution mode.
    "types": ["node"],
    "strict": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
